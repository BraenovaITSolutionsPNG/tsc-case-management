{
  "name": "tsc-case-management",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development NEXT_DIST_DIR=.next-dev next dev -p 3000",
    "build": "next build",
    "start": "NODE_ENV=production next start -p 3000",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:sql": "tsx scripts/build-schema-sql.ts",
    "db:testdata": "tsx scripts/load-test-data.ts",
    "db:convert": "python3 scripts/mysql-to-postgres.py database/tsc_case_management_dump.sql database/postgres-load.sql",
    "db:load": "pnpm db:convert && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/postgres-load.sql"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
